      <Param name="conditions" updates="None" val="[{'scan_a': '../films_LowerRes/Oxygen_LowerRes.mp4', 'scan_b': '../films_LowerRes/BorrowedTime_LowerRes.mp4', 'scan_c': '../films_LowerRes/PlaceOfMyBirth_LowerRes.mp4'}, {'scan_a': '../films_LowerRes/AnObjectAtRest_LowerRes.mp4', 'scan_b': '../films_LowerRes/StrayDogs_LowerRes.mp4', 'scan_c': '../films_LowerRes/Scrambled_LowerRes.mp4'}, {'scan_a': '../films_LowerRes/InnerWorkings_LowerRes.mp4', 'scan_b': '../films_LowerRes/Paperman_LowerRes.mp4', 'scan_c': '../films_LowerRes/FutureBoyfriend_LowerRes.mp4'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$subject_stim_file" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <Routine name="next"/>
    <LoopTerminator name="trials"/>
    <Routine name="end"/>
  </Flow>
</PsychoPy2experiment>
